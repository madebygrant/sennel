{
  "name": "sennel-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build && node build.js",
    "test": "node --test \"src/**/*.test.js\"",
    "build:test": "SENNEL_FAKE_APP=1 vite build && node build.js test",
    "test:pages": "npm run build:test && node --test \"e2e/*.test.js\""
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "puppeteer": "^25.18.1",
    "svelte": "^5.57.2",
    "vite": "^8.3.5"
  }
}
