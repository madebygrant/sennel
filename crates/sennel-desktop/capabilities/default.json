{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: listening for events (Rust emits locked, prompt and quit-asked) and Sennel's own commands, each by name. The dialog plugin may only show the open and save pickers, which hand back a path and read nothing. The fs plugin comes in with it and is granted nothing. No shell or http plugins.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-status",
    "allow-choose",
    "allow-check-path",
    "allow-touch",
    "allow-unlock",
    "allow-quick-unlock",
    "allow-lock",
    "allow-tree",
    "allow-entries",
    "allow-entry",
    "allow-reveal",
    "allow-copy",
    "allow-copy-field",
    "allow-copy-text",
    "allow-clear-clipboard",
    "allow-cycle-sort",
    "allow-rekey",
    "allow-scan-clipboard",
    "allow-scan-file",
    "allow-generate",
    "allow-save-entry",
    "allow-delete-entry",
    "allow-move-entry",
    "allow-move-group",
    "allow-reparent",
    "allow-add-group",
    "allow-rename-group",
    "allow-delete-group",
    "allow-undo",
    "allow-save",
    "allow-merge",
    "allow-reload",
    "allow-audit",
    "allow-history",
    "allow-clear-history",
    "allow-fields",
    "allow-add-field",
    "allow-reveal-field",
    "allow-edit-field",
    "allow-env-preview",
    "allow-save-env",
    "allow-copy-env",
    "allow-attach",
    "allow-remove-field",
    "allow-extract",
    "allow-agent-give",
    "allow-quit"
  ]
}
