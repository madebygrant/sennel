{
  "manifest_version": 3,
  "name": "Sennel",
  "version": "0.1.0",
  "description": "Fill logins from the Sennel password manager.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sennel",
    "default_icon": { "32": "icons/32.png", "64": "icons/64.png" }
  },
  "icons": { "32": "icons/32.png", "64": "icons/64.png", "128": "icons/128.png" },
  "permissions": ["nativeMessaging", "activeTab", "scripting", "storage", "clipboardWrite"],
  "key": "",
  "browser_specific_settings": {
    "gecko": { "id": "{11f92b7a-7cd2-477c-a988-2a64ef2e2091}", "strict_min_version": "128.0" }
  }
}
